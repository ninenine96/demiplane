{
  "name": "demiplane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Your notes, in a pocket dimension.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:migrate:local": "wrangler d1 migrations apply demiplane-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply demiplane-db --remote"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@uiw/react-codemirror": "^4.25.11",
    "@uiw/react-md-editor": "^4.1.2",
    "codemirror": "^6.0.2",
    "dexie": "^4.4.6",
    "dompurify": "^3.4.15",
    "fflate": "^0.8.3",
    "lucide-react": "^1.47.0",
    "marked": "^18.0.13",
    "minisearch": "^7.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@cloudflare/workers-types": "^5.20260919.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  }
}
