{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "demiplane",
  "main": "src/index.ts",
  "routes": [{ "pattern": "demiplane.app", "custom_domain": true }],
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/index.html", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "demiplane-db",
      // Replace with the id printed by: wrangler d1 create demiplane-db
      // Local dev ignores this value and uses .wrangler/state instead.
      "database_id": "2106e302-90ee-4527-a588-df6cb54fdd45",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "demiplane-files"
    }
  ],
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "APP_NAME": "Demiplane",
    "AUTH_DEV_MODE": "false",
    // Sending subdomain, onboarded in Cloudflare Email Sending. The fallback
    // sender in src/lib/email.ts covers a deployment where it is not verified.
    "EMAIL_FROM_ADDRESS": "sigil@unseal.demiplane.app",
    "EMAIL_FROM_NAME": "Demiplane"
  }
}
